{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shp:source-set-manifest:v1",
  "title": "SHP Source Set Manifest",
  "description": "Non-normative manifest for reproducible selection and integrity binding of Structured Hardening Project repository artefacts. A source-set manifest does not confer authority, lifecycle status, platform support, certification eligibility, or normative meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_set",
    "repository",
    "inventory",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "SHP/SourceSetManifest/v1"
    },
    "source_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generator_sha256"
      ],
      "properties": {
        "schema": {
          "const": "SHP/CorpusInventoryDiagnostic/v1"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
